{
  "name": "@mwaeckerlin/mcp-nextcloud",
  "version": "1.0.0",
  "description": "MCP server for Nextcloud API integration - secure API access from sandboxed agents with authentication layer",
  "main": "dist/index.js",
  "bin": {
    "mcp-nextcloud": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "nextcloud",
    "api",
    "model-context-protocol",
    "ai",
    "llm"
  ],
  "author": "mwaeckerlin",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "axios": "1.15.2",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "20.17.47",
    "@typescript-eslint/eslint-plugin": "8.32.1",
    "@typescript-eslint/parser": "8.32.1",
    "eslint": "9.27.0",
    "jest": "29.7.0",
    "ts-jest": "29.3.4",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^(.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/index.ts"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
